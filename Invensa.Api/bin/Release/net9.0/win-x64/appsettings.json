{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "OutputTemplate": "{NewLine}{Timestamp:HH:mm:ss} [{Level}] ({CorrelationToken}) {Message}{NewLine}{Exception}",
    "Dir": "logs/.txt"
  },
  "ConnectionStrings": {
    "InvensaConn": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=Invensa;Integrated Security=True;Encrypt=False;TrustServerCertificate=True"
  },
  "AllowedHosts": "*",
  "Swagger": {
    "RoutePrefix": "",
    "Name": "Invensa",
    "DocumentTitle": "Invensa Api Definition Development"
  },

  "ImageStorage": {
    "BaseRootRelative": "wwwroot"
  },
  "Jwt": {
    "SecretKey": "Invensa_Super_Secret_Key_For_Local_Auth_2026",
    "Issuer": "Invensa.Api",
    "Audience": "Invensa.Client",
    "AccessTokenExpirationMinutes": 60
  }

}